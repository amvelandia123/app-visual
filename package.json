{
  "name": "app-visual",
  "version": "0.1.0",
  "private": true,
  "description": "Laboratorio Visual: simulador web interactivo para aprender herramientas técnicas (módulo 1: Git) viendo qué hace cada comando.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
